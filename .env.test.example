# Configuração para rodar os testes de regressão (tests/*.test.mjs) localmente
# contra um banco de dados ISOLADO. Copie para .env.test e ajuste se precisar.
#
# Nunca aponte para o banco de produção — os testes criam usuários e dados.

DATABASE_URL="postgresql://patrono:patrono@localhost:5432/patrono_test"
NEXTAUTH_SECRET="teste-local-somente-nao-usar-em-producao"
NEXTAUTH_URL="http://localhost:3100"

# Valores fictícios — só para o build não falhar por falta de configuração
# do Supabase. Upload de mídia não funciona nesses testes.
NEXT_PUBLIC_SUPABASE_URL="https://exemplo-local.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="chave-falsa-para-build-local"
SUPABASE_SERVICE_ROLE_KEY="chave-falsa-para-build-local"
