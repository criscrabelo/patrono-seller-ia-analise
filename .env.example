# Patrono Seller IA — contrato de variáveis de ambiente (A11).
# Copie para .env.local e preencha. NUNCA coloque valores reais neste arquivo.
# Valores abaixo são fictícios e inofensivos. Segredos reais ficam fora do repositório.

# ── Banco (obrigatório) ──────────────────────────────────────────────
DATABASE_URL="postgresql://usuario:senha@localhost:5432/patrono"
DIRECT_URL="postgresql://usuario:senha@localhost:5432/patrono"

# ── Autenticação (obrigatório) ───────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="troque-por-um-segredo-aleatorio-de-64-caracteres-hex"
NEXTAUTH_URL="http://localhost:3000"

# ── Supabase / armazenamento de mídia (privadas só no servidor) ──────
NEXT_PUBLIC_SUPABASE_URL="https://exemplo.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="chave-publica-anon-ficticia"
SUPABASE_SERVICE_ROLE_KEY="chave-de-servico-ficticia-nunca-no-navegador"

# ── Primeiro administrador (só para `npm run db:seed`; sem padrão) ───
# SEED_ADMIN_EMAIL="voce@exemplo.com"
# SEED_ADMIN_PASSWORD="senha-forte-com-12-ou-mais-caracteres"

# ── Agendamentos ─────────────────────────────────────────────────────
CRON_SECRET="segredo-aleatorio-dos-agendamentos"

# ── IA (opcionais; custo controlado por PAID_AI_ENABLED) ─────────────
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
FAL_KEY=""
PAID_AI_ENABLED="nao"

# ── E-mail (recuperação de senha) ────────────────────────────────────
RESEND_API_KEY=""
RESEND_FROM=""

# ── Integrações de canais (opcionais; deixe vazio se não usar) ───────
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REDIRECT_URI=""
TIKTOK_SHOP_APP_KEY=""
TIKTOK_SHOP_APP_SECRET=""
TIKTOK_SHOP_REDIRECT_URI=""
MERCADO_LIVRE_APP_ID=""
MERCADO_LIVRE_CLIENT_SECRET=""
AMAZON_CREATORS_CREDENTIAL_ID=""
AMAZON_CREATORS_CREDENTIAL_SECRET=""
AMAZON_CREATORS_PARTNER_TAG=""
